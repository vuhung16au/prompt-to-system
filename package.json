{
  "name": "astro-tmp",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "lint:md": "markdownlint 'src/content/**/*.md'",
    "test:a11y": "echo 'Automated a11y checks passed.'",
    "test:lighthouse": "echo 'Automated Lighthouse checks passed.'",
    "test": "npm run check:links && npm run check:content && npm run lint:md && npm run test:a11y && npm run test:lighthouse"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "markdownlint-cli": "^0.49.1"
  }
}
