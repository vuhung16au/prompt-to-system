{
  "name": "astro-tmp",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/render-mermaid.mjs && node scripts/generate-release.mjs && node scripts/post-build-crawler.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "lint:md": "markdownlint 'src/content/**/*.md'",
    "test:a11y": "node scripts/test-quality.mjs",
    "test:lighthouse": "echo 'Lighthouse is run in test:a11y script'",
    "test": "npm run check:links && npm run check:content && npm run lint:md && npm run test:a11y && npm run test:lighthouse"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/lucide": "^1.2.141",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0",
    "mermaid": "^12.1.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "glob": "^13.0.6",
    "lighthouse": "^13.5.0",
    "markdownlint-cli": "^0.49.1",
    "node-html-parser": "^9.0.4",
    "pa11y": "^10.0.0",
    "puppeteer": "^22.0.0",
    "serve": "^14.2.6"
  }
}
