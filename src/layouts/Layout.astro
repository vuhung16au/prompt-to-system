---
import '../styles/global.css';
import Search from '../components/Search.astro';

export interface Props {
  title: string;
  description?: string;
  variant?: 'reading' | 'wide' | 'full';
}

const { title, description = 'Applied LLM Patterns: Learn to turn one-off prompts into reliable AI systems.', variant = 'reading' } = Astro.props;

const currentPath = Astro.url.pathname;

function isActive(path: string) {
  if (path === '/') {
    return currentPath === import.meta.env.BASE_URL + '/' || currentPath === import.meta.env.BASE_URL;
  }
  return currentPath.startsWith(import.meta.env.BASE_URL + path);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Applied LLM Patterns</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / SEO -->
    <meta property="og:title" content={`${title} | Applied LLM Patterns`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={Astro.url.href} />
    <style>.mermaid-figure svg { max-width: 100%; height: auto; }</style>

  </head>
  <body class="min-h-screen flex flex-col transition-colors duration-300">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-[100] focus:p-4 focus:bg-surface focus:text-accent-primary focus:outline-none focus:ring-2 focus:ring-border-focus">
      Skip to main content
    </a>

    <header class="bg-surface-muted text-text-heading border-b border-border-subtle sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-2">
          <svg class="w-6 h-6 text-accent-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <a href={import.meta.env.BASE_URL + "/"} class="text-xl font-bold tracking-tight hover:text-accent-primary transition-colors">
            Applied LLM Patterns
          </a>
        </div>
        
        <nav class="flex flex-col md:flex-row items-center gap-4 md:gap-6 text-sm font-medium">
          <ul class="flex flex-wrap items-center gap-4 md:gap-6">
            <li>
              <a href={import.meta.env.BASE_URL + "/learn"} class={`transition-colors ${isActive('/learn') ? 'text-accent-primary border-b-2 border-accent-primary pb-1' : 'hover:text-accent-primary pb-1'}`}>
                Learn
              </a>
            </li>
            <li>
              <a href={import.meta.env.BASE_URL + "/examples"} class={`transition-colors ${isActive('/examples') ? 'text-accent-primary border-b-2 border-accent-primary pb-1' : 'hover:text-accent-primary pb-1'}`}>
                Examples
              </a>
            </li>
            <li>
              <a href={import.meta.env.BASE_URL + "/domains"} class={`transition-colors ${isActive('/domains') ? 'text-accent-primary border-b-2 border-accent-primary pb-1' : 'hover:text-accent-primary pb-1'}`}>
                Domains
              </a>
            </li>
            <li>
              <a href={import.meta.env.BASE_URL + "/glossary"} class={`transition-colors ${isActive('/glossary') ? 'text-accent-primary border-b-2 border-accent-primary pb-1' : 'hover:text-accent-primary pb-1'}`}>
                Glossary
              </a>
            </li>
            <li>
              <a href={import.meta.env.BASE_URL + "/about"} class={`transition-colors ${isActive('/about') ? 'text-accent-primary border-b-2 border-accent-primary pb-1' : 'hover:text-accent-primary pb-1'}`}>
                About
              </a>
            </li>
            <li>
              <a href={import.meta.env.BASE_URL + "/faq"} class={`transition-colors ${isActive('/faq') ? 'text-accent-primary border-b-2 border-accent-primary pb-1' : 'hover:text-accent-primary pb-1'}`}>
                FAQ
              </a>
            </li>
          </ul>
          <div class="bg-surface rounded-md px-2 py-1 border border-border-subtle focus-within:ring-2 focus-within:ring-border-focus">
            <Search />
          </div>
        </nav>
      </div>
    </header>

    <script>
      import mermaid from "mermaid";
      document.addEventListener("DOMContentLoaded", () => {
        mermaid.initialize({ startOnLoad: false });
        document.querySelectorAll("pre[data-language=\"mermaid\"]").forEach(async (el, i) => {
          try {
            const { svg } = await mermaid.render(`mermaid-${i}`, el.textContent || "");
            const figure = document.createElement("figure");
            figure.className = "mermaid-figure overflow-x-auto my-6";
            figure.innerHTML = svg;
            el.parentNode.replaceChild(figure, el);
          } catch (e) { console.error(e); }
        });
      });
    </script>

    <main id="main-content" class="flex-grow w-full mx-auto py-8 md:py-12">
      <slot />
    </main>

    <footer class="bg-surface-muted text-text-muted mt-auto border-t border-border-subtle">
      <div class="max-w-6xl mx-auto px-4 py-8 text-center text-sm flex flex-col md:flex-row justify-between items-center gap-4">
        <p>&copy; 2026 Vu Hung and contributors &middot; Content: <a href="https://creativecommons.org/licenses/by-sa/4.0/" class="hover:text-accent-primary hover:underline">CC BY-SA 4.0</a> &middot; Code: MIT</p>
        <div class="flex gap-4">
          <a href={import.meta.env.BASE_URL + "/"} class="hover:text-accent-primary">Home</a>
          <a href={import.meta.env.BASE_URL + "/about"} class="hover:text-accent-primary">About</a>
          <a href={import.meta.env.BASE_URL + "/faq"} class="hover:text-accent-primary">FAQ</a>
          <a href="https://github.com/vuhung16au/prompt-to-system" class="hover:text-accent-primary">GitHub Repository</a>
        </div>
      </div>
    </footer>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('pre').forEach(pre => {
          if (pre.parentNode && (pre.parentNode as HTMLElement).classList.contains('code-wrapper')) return;
          if (pre.classList.contains('mermaid') || pre.getAttribute('data-language') === 'mermaid') return;

          const wrapper = document.createElement('div');
          wrapper.className = 'code-wrapper relative group';
          
          if (pre.parentNode) {
            pre.parentNode.insertBefore(wrapper, pre);
            wrapper.appendChild(pre);
          }

          const btn = document.createElement('button');
          btn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>`;
          btn.className = 'absolute top-2 right-2 p-2 bg-surface-muted hover:bg-surface text-text-body border border-border-subtle rounded opacity-0 group-hover:opacity-100 transition-all duration-200';
          btn.title = 'Copy code';
          btn.setAttribute('aria-label', 'Copy code to clipboard');

          wrapper.appendChild(btn);

          btn.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.innerText || pre.innerText;
            try {
              await navigator.clipboard.writeText(code);
              btn.innerHTML = `<svg class="w-4 h-4 text-status-success" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>`;
              setTimeout(() => {
                btn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>`;
              }, 2000);
            } catch (err) {
              console.error('Failed to copy', err);
            }
          });
        });
      });
    </script>
  </body>
</html>
