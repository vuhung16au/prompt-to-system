---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const domains = await getCollection('domains');
---
<Layout title="Domains">
  <h1>Domains</h1>
  <p>Browse content by domain.</p>
  
  <ul>
    {domains.map((domain) => (
      <li>
        <a href={import.meta.env.BASE_URL + `/domains/${domain.id}`}>{domain.data.title}</a>
        <p>{domain.data.summary}</p>
      </li>
    ))}
  </ul>
</Layout>
