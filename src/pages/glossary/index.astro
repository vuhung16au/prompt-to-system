---
import { getCollection } from 'astro:content';
import Container from '@/components/layout/Container.astro';
import Layout from '../../layouts/Layout.astro';

const glossaryEntries = await getCollection('glossary');
glossaryEntries.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Group by first letter
const grouped = glossaryEntries.reduce((acc, entry) => {
  const firstLetter = entry.data.title.charAt(0).toUpperCase();
  if (!acc[firstLetter]) acc[firstLetter] = [];
  acc[firstLetter].push(entry);
  return acc;
}, {} as Record<string, typeof glossaryEntries>);

const letters = Object.keys(grouped).sort();
---

<Layout title="Glossary | Applied LLM Patterns">
  <Container variant="reading">
    <div class="py-12 md:py-20">
      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl font-extrabold text-text-heading mb-6 tracking-tight">Glossary</h1>
        <p class="text-xl text-text-muted leading-relaxed">
          Definitions for important terms, concepts, and patterns used throughout the curriculum.
        </p>
      </header>

      {/* Alphabet Jump Links */}
      <div class="flex flex-wrap gap-2 mb-12 pb-6 border-b border-border-subtle">
        {letters.map(letter => (
          <a href={`#letter-${letter}`} class="w-8 h-8 flex items-center justify-center rounded-md bg-surface-muted hover:bg-accent-primary hover:text-white text-sm font-bold text-text-heading transition-colors">
            {letter}
          </a>
        ))}
      </div>

      {glossaryEntries.length === 0 ? (
        <div class="p-8 text-center border border-dashed border-border-strong rounded-2xl text-text-muted">
          The glossary is currently empty.
        </div>
      ) : (
        <div class="space-y-16">
          {letters.map(letter => (
            <div id={`letter-${letter}`} class="scroll-mt-24">
              <div class="flex items-center gap-4 mb-8">
                <h2 class="text-3xl font-extrabold text-text-heading">{letter}</h2>
                <div class="flex-grow h-px bg-border-subtle"></div>
              </div>
              
              <dl class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {grouped[letter].map((entry) => (
                  <div class="bg-surface p-6 rounded-2xl border border-border-subtle shadow-sm flex flex-col" id={entry.id}>
                    <dt class="text-lg font-bold text-text-heading mb-2">{entry.data.title}</dt>
                    <dd class="text-sm text-text-body flex-grow">
                      {entry.data.summary}
                    </dd>
                    {entry.data.aliases && entry.data.aliases.length > 0 && (
                      <div class="mt-4 pt-4 border-t border-border-subtle">
                        <span class="text-xs font-medium text-text-muted">Also known as: </span>
                        <span class="text-xs text-text-body">{entry.data.aliases.join(', ')}</span>
                      </div>
                    )}
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      )}
    </div>
  </Container>
</Layout>
