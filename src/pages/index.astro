---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <h1>Applied LLM Patterns</h1>
  <p>Applied LLM Patterns is a concise educational website for intermediate and advanced LLM users.</p>
  
  <h2>Learning Path</h2>
  <ul>
    <li>Prompt engineering</li>
    <li>Context engineering</li>
    <li>Workflow engineering</li>
    <li>Harness engineering</li>
    <li>Loop engineering</li>
  </ul>

  <h2>Get Started</h2>
  <ul>
    <li><a href={import.meta.env.BASE_URL + "/learn"}>Learn a concept</a></li>
    <li><a href={import.meta.env.BASE_URL + "/examples"}>Find an example</a></li>
    <li><a href={import.meta.env.BASE_URL + "/domains"}>Browse a domain</a></li>
  </ul>
</Layout>
