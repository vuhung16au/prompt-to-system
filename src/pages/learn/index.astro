---
const tracks = [
  { id: 'Track 1', title: 'Architecture & Orchestration', desc: 'System design and multi-agent patterns' },
  { id: 'Track 2', title: 'Retrieval & Context', desc: 'RAG and context engineering' },
  { id: 'Track 3', title: 'Tools & Interoperability', desc: 'MCP and sandboxed execution' },
  { id: 'Track 4', title: 'Evaluation & Measurement', desc: 'Continuous testing and judges' },
  { id: 'Track 5', title: 'Reliability & Resilience', desc: 'Failure handling and state' },
  { id: 'Track 6', title: 'Security & Privacy', desc: 'Threat models and trust boundaries' },
  { id: 'Track 7', title: 'Observability & Economics', desc: 'Traces, SLIs, and cost' },
  { id: 'Track 8', title: 'Technical Leadership', desc: 'Governance and interventions' }
];

function getTrackLessons(trackId: string) {
  return sortedLessons.filter(l => l.data.track === trackId || l.data.track?.startsWith(trackId));
}

function getTrackEffort(trackLessons: any[]) {
  return trackLessons.reduce((acc, l) => acc + (l.data.estimated_lab_minutes || 0), 0);
}

function getTrackArtifacts(trackLessons: any[]) {
  const artifacts = new Set<string>();
  trackLessons.forEach(l => {
    (l.data.required_artifacts || []).forEach(a => artifacts.add(a));
  });
  return Array.from(artifacts);
}

import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Container from '@/components/layout/Container.astro';
import Prose from '@/components/layout/Prose.astro';
import LearningStep from '@/components/domain/LearningStep.astro';
import Card from '@/components/ui/Card.astro';

// Get all lessons and sort by order
const lessons = await getCollection('lessons');
const sortedLessons = lessons.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

// We can define the 5 primary stages as per the model
const stages = [
  { stage: 1, title: 'Prompt engineering', desc: 'Define what the model should do.' },
  { stage: 2, title: 'Context engineering', desc: 'Provide what the model should know and see.' },
  { stage: 3, title: 'Workflow engineering', desc: 'Arrange the steps that produce the result.' },
  { stage: 4, title: 'Harness engineering', desc: 'Provide tools, permissions, state, tests, and guardrails.' },
  { stage: 5, title: 'Loop engineering', desc: 'Control repeated work, convergence, recovery, escalation, and stopping.' }
];

const crossCutting = sortedLessons.filter(l => l.data.stage === 6 || l.id.includes('evaluation') || l.id.includes('safety'));
---

<Layout title="Learn: The Path to Systems">
  <Container variant="wide">
    <div class="py-12 md:py-20">
      <div class="max-w-3xl mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-text-heading mb-6 tracking-tight">The Learning Path</h1>
        <p class="text-lg text-text-body leading-relaxed">
          Follow the five-layer model to progress from writing isolated prompts to building reliable AI systems. Start with clear instructions, then add context, string steps together into workflows, wrap them in secure agent harnesses, and control them with loops.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16">
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-bold text-text-heading mb-8">The Five-Layer Model</h2>
          
          <div class="space-y-2 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-border-subtle before:to-transparent">
            {stages.map(stage => {
              const stageLessons = sortedLessons.filter(l => l.data.stage === stage.stage);
              return (
                <div class="mb-12 relative">
                  <div class="flex items-center mb-6">
                    <div class="w-10 h-10 rounded-full bg-accent-muted text-accent-primary font-bold flex items-center justify-center border-2 border-surface z-10 shadow-sm relative shrink-0">
                      {stage.stage}
                    </div>
                    <h3 class="text-xl font-bold text-text-heading ml-4">{stage.title}</h3>
                  </div>
                  
                  <div class="pl-14">
                    <p class="text-text-muted mb-6">{stage.desc}</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                      {stageLessons.map(lesson => (
                        <Card href={import.meta.env.BASE_URL + `/learn/${lesson.id}`} class="p-4 sm:p-5 h-full flex flex-col">
                          <h4 class="font-bold text-text-heading mb-1">{lesson.data.title}</h4>
                          <p class="text-sm text-text-body mb-3 line-clamp-2 flex-grow">{lesson.data.summary}</p>
                          <div class="flex justify-between items-center mt-auto text-xs font-medium text-text-muted">
                            <span class="uppercase tracking-wider">{lesson.data.level}</span>
                            <span>{lesson.data.duration_minutes ? `${lesson.data.duration_minutes} min` : ''}</span>
                          </div>
                        </Card>
                      ))}
                      {stageLessons.length === 0 && (
                        <div class="col-span-2 p-4 border border-dashed border-border-subtle rounded-xl text-text-muted text-sm text-center">
                          Lessons coming soon
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
        
        <div>
          <div class="sticky top-24 bg-surface-muted rounded-2xl p-6 md:p-8 border border-border-subtle shadow-sm">
            <h3 class="text-lg font-bold text-text-heading mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-accent-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
              Cross-cutting Tracks
            </h3>
            <p class="text-sm text-text-body mb-6">
              Evaluation, reliability, and safety principles apply to all five layers of the system.
            </p>
            <div class="space-y-4">
              {crossCutting.map(lesson => (
                <a href={import.meta.env.BASE_URL + `/learn/${lesson.id}`} class="block group">
                  <div class="p-4 bg-surface border border-border-subtle rounded-xl group-hover:border-border-strong group-hover:shadow-sm transition-all">
                    <h4 class="font-bold text-text-heading group-hover:text-accent-primary transition-colors mb-1">{lesson.data.title}</h4>
                    <p class="text-xs text-text-muted line-clamp-2">{lesson.data.summary}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="mt-20 pt-16 border-t border-border-strong">
        <div class="max-w-3xl mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-text-heading mb-4 tracking-tight">Advanced Systems Path</h2>
          <p class="text-lg text-text-body leading-relaxed">
            A production-oriented curriculum for senior engineers. Learn to make architecture decisions, measure trade-offs, operate agents with measurable reliability, and recover from failures in distributed AI systems.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <Card class="p-6 md:p-8">
            <h3 class="text-xl font-bold text-text-heading mb-3">Role-based Starting Points</h3>
            <ul class="space-y-3 text-text-body">
              <li class="flex items-start gap-2">
                <span class="text-accent-primary font-bold">&rarr;</span>
                <span><strong>Agent Engineer:</strong> Focus on orchestration, long-running execution, memory, and multi-agent coordination.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-primary font-bold">&rarr;</span>
                <span><strong>AI Platform Engineer:</strong> Focus on RAG architectures, tools, MCP gateways, latency, and cost engineering.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-primary font-bold">&rarr;</span>
                <span><strong>ML Engineer to Systems:</strong> Focus on context engineering, evaluation, models vs. tools, and synthetic data.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-primary font-bold">&rarr;</span>
                <span><strong>Security Engineer:</strong> Focus on threat modelling, capability security, sandboxes, and supply-chain security.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-accent-primary font-bold">&rarr;</span>
                <span><strong>Technical Lead:</strong> Focus on architecture reviews, SLOs, failure taxonomies, budgets, and escalation boundaries.</span>
              </li>
            </ul>
          </Card>
          
          <Card class="p-6 md:p-8 bg-surface-muted border-accent-muted">
            <h3 class="text-xl font-bold text-text-heading mb-3">Cornerstone Lessons</h3>
            <div class="space-y-4 mt-4">
              {sortedLessons.filter(l => l.data.level === 'advanced').map(lesson => (
                <a href={import.meta.env.BASE_URL + `/learn/${lesson.id}`} class="block group p-4 bg-surface border border-border-subtle rounded-xl hover:border-accent-primary transition-colors">
                  <h4 class="font-bold text-text-heading group-hover:text-accent-primary transition-colors mb-1">{lesson.data.title}</h4>
                  <p class="text-sm text-text-body">{lesson.data.summary}</p>
                </a>
              ))}
            </div>
            {sortedLessons.filter(l => l.data.level === 'advanced').length === 0 && (
              <p class="text-sm text-text-muted mt-4">Advanced content is currently being published.</p>
            )}
          </Card>
        </div>
      </div>
    </div>
  </Container>
</Layout>
