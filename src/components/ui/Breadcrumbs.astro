---
export interface Breadcrumb {
  label: string;
  href?: string;
}

export interface Props {
  items: Breadcrumb[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---
<nav aria-label="Breadcrumb" class={`flex ${className}`}>
  <ol role="list" class="flex items-center space-x-2 text-sm text-text-muted">
    {items.map((item, index) => (
      <li class="flex items-center">
        {index > 0 && (
          <svg class="h-4 w-4 flex-shrink-0 text-border-strong mx-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {item.href ? (
          <a href={item.href} class="hover:text-accent-primary transition-colors">{item.label}</a>
        ) : (
          <span class="text-text-heading font-medium" aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
