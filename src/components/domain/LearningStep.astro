---
export interface Props {
  stepNumber: number;
  title: string;
  description: string;
  timeEstimate?: string;
  href?: string;
  isActive?: boolean;
}
const { stepNumber, title, description, timeEstimate, href, isActive = false } = Astro.props;
---
<div class={`relative flex gap-6 pb-8 ${isActive ? 'opacity-100' : 'opacity-80 hover:opacity-100 transition-opacity'}`}>
  <div class="flex-shrink-0 flex flex-col items-center">
    <div class={`w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm z-10 ${isActive ? 'bg-accent-primary text-white ring-4 ring-accent-muted' : 'bg-surface-muted text-text-heading border-2 border-border-strong'}`}>
      {stepNumber}
    </div>
    <div class="w-px h-full bg-border-subtle absolute top-10 bottom-0 left-5 -z-0"></div>
  </div>
  <div class="flex-grow pt-1">
    <h3 class="text-lg font-bold text-text-heading mb-2">
      {href ? <a href={href} class="hover:text-accent-primary before:absolute before:inset-0">{title}</a> : title}
    </h3>
    <p class="text-sm text-text-muted mb-3">{description}</p>
    {timeEstimate && <span class="text-xs font-medium bg-surface-muted text-text-muted px-2.5 py-1 rounded-md flex items-center gap-1">⏱ {timeEstimate}</span>}
  </div>
</div>
