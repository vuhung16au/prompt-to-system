---
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';

export interface Props {
  title: string;
  summary: string;
  href: string;
  level?: string;
  timeEstimate?: string;
}
const { title, summary, href, level, timeEstimate } = Astro.props;
---
<Card href={href} class="flex flex-col h-full">
  <div class="flex-grow">
    <h3 class="text-lg font-bold text-text-heading mb-2">{title}</h3>
    <p class="text-sm text-text-body mb-4 line-clamp-3">{summary}</p>
  </div>
  <div class="flex items-center gap-2 mt-4 pt-4 border-t border-border-subtle">
    {level && <Tag variant="accent">{level}</Tag>}
    {timeEstimate && <span class="text-xs text-text-muted">{timeEstimate}</span>}
  </div>
</Card>
