---
export interface LinkProps {
  title: string;
  href: string;
}

export interface Props {
  next?: LinkProps;
  previous?: LinkProps;
}
const { next, previous } = Astro.props;
---
<div class="flex flex-col sm:flex-row gap-4 mt-12 pt-8 border-t border-border-subtle">
  <div class="flex-1">
    {previous && (
      <a href={previous.href} class="group flex flex-col p-4 rounded-lg border border-border-subtle hover:border-accent-primary hover:bg-surface-muted transition-all text-left">
        <span class="text-xs font-medium text-text-muted mb-1 flex items-center gap-1 group-hover:text-accent-primary">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
          Previous
        </span>
        <span class="text-sm font-bold text-text-heading">{previous.title}</span>
      </a>
    )}
  </div>
  <div class="flex-1">
    {next && (
      <a href={next.href} class="group flex flex-col p-4 rounded-lg border border-border-subtle hover:border-accent-primary hover:bg-surface-muted transition-all text-right items-end">
        <span class="text-xs font-medium text-text-muted mb-1 flex items-center gap-1 group-hover:text-accent-primary">
          Next
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </span>
        <span class="text-sm font-bold text-text-heading">{next.title}</span>
      </a>
    )}
  </div>
</div>
