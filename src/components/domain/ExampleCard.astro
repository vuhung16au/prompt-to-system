---
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';

export interface Props {
  title: string;
  summary: string;
  href: string;
  type?: string;
  domains?: string[];
  evidenceProduced?: string;
}
const { title, summary, href, type, domains = [], evidenceProduced } = Astro.props;
---
<Card href={href} class="flex flex-col h-full">
  <div class="flex-grow">
    <div class="flex items-start justify-between mb-2">
      <h3 class="text-md font-bold text-text-heading pr-2">{title}</h3>
      {type && <Tag variant="default">{type}</Tag>}
    </div>
    <p class="text-sm text-text-body mb-2 line-clamp-2">{summary}</p>
    {evidenceProduced && (
      <div class="text-xs text-text-muted mt-2 p-2 bg-surface rounded-md border border-border-subtle">
        <span class="font-semibold">Evidence:</span> {evidenceProduced}
      </div>
    )}
  </div>
  {domains.length > 0 && (
    <div class="flex flex-wrap gap-1 mt-4 pt-4 border-t border-border-subtle">
      {domains.slice(0, 3).map(domain => (
        <span class="text-xs font-medium text-text-muted bg-surface-muted px-2 py-0.5 rounded-sm">{domain}</span>
      ))}
      {domains.length > 3 && <span class="text-xs text-text-muted">+{domains.length - 3}</span>}
    </div>
  )}
</Card>
