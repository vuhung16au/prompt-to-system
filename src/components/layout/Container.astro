---
export interface Props {
  variant?: 'reading' | 'wide' | 'full';
  class?: string;
}
const { variant = 'reading', class: className = '' } = Astro.props;

const maxWs = {
  reading: 'max-w-3xl',
  wide: 'max-w-5xl',
  full: 'max-w-full px-4 sm:px-6 lg:px-8',
};
---
<div class={`mx-auto px-4 sm:px-6 lg:px-8 ${maxWs[variant]} ${className}`}>
  <slot />
</div>
